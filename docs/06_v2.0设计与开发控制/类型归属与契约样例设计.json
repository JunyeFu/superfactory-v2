  "id_mapping": {
    "new_transparent_string_ids": [
      "ExecutionSessionId",
      "ExecutionEpochId",
      "DispatchCommandId",
      "CloudProjectId",
      "CloudDatasetId",
      "DeviceBootId",
      "ObservationProbeId"
    ],
    "reuse": [
      "ProjectId for local project",
      "ObjectId for device/logical job/Host context/receipt/work/request identifiers",
      "PhaseId/PortId/RoleId for existing model identity",
      "TaskId only for actual async Task",
      "RunId only for actual local prediction Run; ReportRunInputRef is existing path-free Project/scenario identity",
      "ObjectId for actual cloud data export_id; no new identity family"
    ],
    "rule": "复用现有string_id构造规则（非空无NUL）；cloud project与local Project不因字符串相同授权；身份值不是grant",
    "revision_rule": "Project Revision和execution revision为不同语义字段；wire均SafeUint。类型名/字段匹配、实际比较来源必须明确，不以互相赋值混用"
  },
  "serialization_rules": {
    "required_nullable": "新DTO中出现在required且允许null的字段，Rust Option字段显式present_nullable反序列化、schemars(required)，序列化不skip None；TS为T|null而不是可选属性",
    "helper_placement": "commands沿用api.rs现有helper；domain/cloud_execution.rs需同义的窄本地helper，不能为了复用helper产生domain->commands依赖",
    "legacy_exception": "原TaskState新增originating_request_id保留对旧任务可省略；选择把当前单个TaskState从model!等价展开为显式struct，只给新增字段default/skip_none/TS optional；不修改其他旧DTO语义",
    "new_task_condition": "H01/H08/H10/H11来源Task必须填原request_id；get_task及managed原始数据先按originating_operation选择新任务严格视图，再转换统一TaskState。实际schema含新操作条件，旧宽分支不得放过新任务缺ID或错误kind/输出",
    "task_handle_views": "Startup/CloudRead/ExportingTaskHandle先按新操作严格wire DTO反序列化（nullable字段必现），再核对kind并转换原TaskHandle；缺省字段必须在被Option归None之前拒绝。内部不建第二任务状态或TaskId；Rust schema/TS精化对应常量及必填字段",
    "lookup_correlation": "ExecutionRequestStatus以4个互斥registered分支关联operation及特定handle，另有not_found；draft7修正旧独立组合的过宽形状",
    "unknown_fields": "新对象/分支deny_unknown_fields；不采用会吞掉未知字段的Value封套或宽松catch；现有project_id显式nullable继续保留",
    "formats_and_semantics": "format=date-time须在标准校验profile启用断言，String派生本身不算验证；业务身份/权限/epoch/时间关系和已注册Task查询另外由真实消费者证明，schema不替代",
    "const_fields": "字符串const用封闭tag/单值枚举；const null字段用严格null表示；const bool由局部受限值/实际边界转换检查。普通String/bool/Option派生不自动等价于const约束；生成schema和typed decoder使用同一精化规则",
    "scope_refinement": "现有Request<O,P>仍供新操作使用；实际新请求schema精化scope=project，Host仍按真实作用域授权。project_id字段显式null可通过结构但仍须由Host拒绝，保留原API约定",
    "cloud_timestamp": "纯domain窄时间值；DateTime<Utc>内部值，显式parse/serialize；验证日历/已知offset/微秒/UTC年范围，拒绝-00:00和闰秒；输出UTC6位；TS string、schema format+pattern由实际wrapper导出，普通String或默认chrono serde派生不足",
    "prediction_report": "H10 prediction、canonical prediction_comparison及回执prediction均必填可空；严格wrapper导出/解析；side_by_side两delta为null、observational至少一个已知、scope=null时数量delta=null；实际producer按每指标条件判断，schema不代替业务来源核对",
    "cloud_data_export": "H10/H11共享ExportingTaskHandle但原operation/result不同；不在HostOkData重复同构oneOf；JSONL每记录精确类型；TelemetryCursor.after_row_index必填可空用于从index0前开始；selected_device_ids绑定实际筛选集合"
  },
