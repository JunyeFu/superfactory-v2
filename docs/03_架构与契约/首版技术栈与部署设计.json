  "layer_routes": [
    {
      "layer": "UI/3D",
      "decision": "React/TS管理UI，Three.js命令式Scene适配接收同源快照；不把3000事件逐条复制到React状态，也不借动画驱动Engine。",
      "owner": "W02/W03",
      "trial": "批准Figma后的真实桌面invoke→编辑→渲染/截图与NFR采样。"
    },
    {
      "layer": "native_commands",
      "decision": "Tauri invoke和Windows管道解码到同一Rust Commands；Host是活动工程唯一拥有者，短锁提交，长计算脱锁冻结输入。",
      "owner": "W00",
      "trial": "两调用源同R竞争、旧Run/新草稿隔离、取消竞争与主线程可响应。"
    },
