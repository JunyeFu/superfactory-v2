{
  "document_kind": "industry_site_generation_profile_design_not_runtime",
  "industry": "paper_carton_manufacturing",
  "product_family": "die_cut_fold_glued_paper_carton",
  "site_unit": "m",
  "product_geometry_unit": "mm",
  "goal_fields": [
    "daily_accepted_quantity",
    "quantity_unit",
    "acceptance_scope",
    "production_day_calendar",
    "observation_window",
    "site_length_m",
    "site_width_m",
    "site_height_m"
  ],
  "parameter_sources": [
    "user_provided",
    "module_declared",
    "template_declared_example",
    "unknown"
  ],
  "layout_patterns": [
    "straight_line",
    "u_shape",
    "parallel_lines"
  ],
  "layout_rules": [
    "fit_hall_envelope_and_height",
    "use_declared_footprint_not_display_scale",
    "reserve_declared_loading_maintenance_and_transport_spaces",
    "preserve_internal_port_connections_when_copying_line"
  ],
  "process_graph": {
    "entry": "purchased_board_arrival",
    "stages": [
      {
        "id": "printing",
        "optional": true,
        "input": "board",
        "output": "ready_board"
      },
      {
        "id": "die_cut",
        "input": "board_or_ready_board",
        "output": "carton_blank"
      },
      {
        "id": "fold_glue",
        "input": "carton_blank",
        "output": "carton"
      },
      {
        "id": "inspect",
        "input": "carton",
        "output": "released_or_rework_or_quarantined_carton"
      },
      {
        "id": "bundle",
        "input": "released_carton",
        "output": "bundle_preserving_carton_content"
      }
    ],
    "destination": "finished_carton_acceptance_store",
    "target_measure": "accepted_released_carton_count_not_bundle_count",
    "upstream_board_manufacturing": "not_in_this_profile"
  },
  "nine_category_roles": {
    "items": [
      "board",
      "ready_board",
      "carton_blank",
      "carton",
      "bundle",
      "waste"
    ],
    "devices": [
      "printing_optional",
      "die_cut",
      "fold_glue",
      "inspection",
      "bundling",
      "buffer_transfer"
    ],
    "resources": [
      "operators",
      "tools",
      "vehicle_if_selected"
    ],
    "tasks": [
      "setup",
      "loading_unloading",
      "supported_rework"
    ],
    "operations": [
      "declared_transform",
      "inspection_split",
      "bundle_content_relation"
    ],
    "transport": [
      "internal_transfer_and_finished_goods_supply"
    ],
    "templates": [
      "hall_line_groups_and_site_layout"
    ],
    "professional": [
      "paper_structure_and_manufacturing_artifact_if_required"
    ],
    "media": [
      "declared_native_geometry_or_permitted_assets"
    ]
  },
  "must_resolve_before_evaluation": [
    "product_specification_and_bom",
    "stage_cycle_time_and_units_per_cycle",
    "machine_footprint_height_and_clearance",
    "operators_and_calendars",
    "arrival_and_transfer_conditions",
    "quality_input_source_and_policy",
    "observation_window_and_acceptance_scope"
  ],
  "goal_bindings": [
    {
      "from": "resolved Quantity + AcceptanceScope",
      "to": "ScenarioInput.orders/production_tasks with explicit demand choice"
    },
    {
      "from": "goal.site_envelope.length_m/width_m/height_m",
      "to": "HallDesign.width_m/depth_m/height_m"
    },
    {
      "from": "resolved Calendar + observation_window",
      "to": "ResourceInstance.calendar_id + ScenarioInput.window"
    }
  ],
  "forbidden_bindings": [
    "goal.daily_accepted_quantity_to_result.accepted_quantity"
  ],
  "initial_machine_sizing": "ceil(Q * stage_cycle_seconds / (effective_stage_seconds * equivalent_cartons_per_cycle)); optimistic bound only",
  "initial_stock_policy": "do_not_copy_template_runtime_stock; generate explicit sourced_supply_assumptions",
  "example_goal": {
    "text": "日产一万个纸箱并提供场地长宽高",
    "daily_accepted_quantity": 10000,
    "site_dimensions": null,
    "production_day_calendar": null,
    "actual_result": null
  },
  "ready_for_runtime": false,
  "actual_result": null,
  "product_scope_note": "selected die-cut/fold-glued carton family; confirm actual carton specification and route before generation, not every carton type",
  "site_coordinate_binding": {
    "user_length_m": "hall.width_m (X)",
    "user_width_m": "hall.depth_m (Y)",
    "user_height_m": "hall.height_m (Z)",
    "note": "existing hall width_m/depth_m naming retained; user L/W labels do not swap product dimensions"
  },
  "generic_goal_field_mapping": {
    "daily_accepted_quantity": "FactoryGenerationGoal.accepted_quantity_per_day.value",
    "quantity_unit": "FactoryGenerationGoal.accepted_quantity_per_day.unit + acceptance_scope.unit",
    "acceptance_scope": "FactoryGenerationGoal.acceptance_scope (product_ref/unit/destination/stage)",
    "production_day_calendar": "FactoryGenerationGoal.production_calendar_ref",
    "observation_window": "FactoryGenerationGoal.observation_window (start_ms/end_ms)",
    "site_length_m": "FactoryGenerationGoal.site_envelope.length_m",
    "site_width_m": "FactoryGenerationGoal.site_envelope.width_m",
    "site_height_m": "FactoryGenerationGoal.site_envelope.height_m"
  },
  "definition_version": "DRF04-1",
  "canonical_domain_ref": "packages/domain/types.design.rs",
  "instantiation_contract_ref": "modules/templates/instantiation.design.json",
  "canonical_bindings": [
    {
      "input": "daily_accepted_quantity",
      "target": "FactoryGenerationGoal.accepted_quantity_per_day.value",
      "type": "DecimalAmount",
      "conversion": "exact decimal coefficient/decimal_places from explicit target; integer cartons -> coefficient=Q,decimal_places=0",
      "consumer": "ScenarioInput order/task quantity; never accepted result"
    },
    {
      "input": "quantity_unit",
      "target": "FactoryGenerationGoal.accepted_quantity_per_day.unit",
      "type": "UnitId",
      "also": "FactoryGenerationGoal.acceptance_scope.unit",
      "rule": "accepted carton unit from ItemType/declared bundle content conversion"
    },
    {
      "input": "product_specification",
      "target": "FactoryGenerationGoal.product_specification_ref",
      "type": "SubjectRevisionRef",
      "rule": "selected product revision, not display title"
    },
    {
      "input": "acceptance_scope",
      "target": "FactoryGenerationGoal.acceptance_scope",
      "type": "AcceptanceScope",
      "required": [
        "product_ref",
        "unit",
        "destination",
        "stage"
      ]
    },
    {
      "input": "production_day_calendar",
      "target": "FactoryGenerationGoal.production_calendar_ref",
      "type": "ObjectId|null",
      "rule": "explicit actual calendar; null remains missing"
    },
    {
      "input": "observation_window",
      "target": "FactoryGenerationGoal.observation_window",
      "type": "WindowMs",
      "unit": "relative integer millisecond"
    },
    {
      "input": "site_length_m",
      "target": "FactoryGenerationGoal.site_envelope.length_m",
      "type": "FiniteNumber|null",
      "hall_target": "HallDesign.width_m",
      "unit": "m"
    },
    {
      "input": "site_width_m",
      "target": "FactoryGenerationGoal.site_envelope.width_m",
      "type": "FiniteNumber|null",
      "hall_target": "HallDesign.depth_m",
      "unit": "m"
    },
    {
      "input": "site_height_m",
      "target": "FactoryGenerationGoal.site_envelope.height_m",
      "type": "FiniteNumber|null",
      "hall_target": "HallDesign.height_m",
      "unit": "m"
    }
  ],
  "source_value_rule": "ParameterSource(target,field_path,TypedValue|null,basis,source_ref); unknown has no executable value; do not send design aliases as wire fields",
  "adoption_rule": "exact ModuleRef.id/version, explicit role/resource reuse, atomic InstantiateTemplate; explicit_new_scenario_seed=null until selected supply/order conditions",
  "feedback_repair_limit": {
    "max_rounds": 3,
    "initial_run_counts": false,
    "max_capacity_runs": 4,
    "stop_on_target_met_or_missing_inputs_or_no_effective_change": true,
    "failed_check_after_committed_repair_consumes_round": true
  },
  "layout_fill_algorithm": {
    "inputs": [
      "selected available mode",
      "declared ordered station/line groups",
      "each actual rotated footprint and loading/maintenance envelope",
      "explicit anchor/rotation/gaps",
      "actual Hall height/bounds/obstacles"
    ],
    "straight_line": "station min x[0]=anchor_x; min x[i+1]=min x[i]+envelope_width[i]+declared_gap; keep declared y/rotation",
    "u_shape": "use explicitly declared split_index and two ordered rows/turn anchors; row2 direction reversed; no automatic optimal split",
    "parallel_lines": "use explicitly allowed line_count and declared row pitch/anchors; copy fresh instances and bind shared resources explicitly",
    "check": "transform actual footprints/envelopes into Hall coordinates; bounds/height/overlap/clearance; insufficient geometry -> unknown, collision -> object-specific Fail",
    "availability": "layout names are candidate design modes; use only actually supplied profile transforms/parameters, otherwise missing condition",
    "output": "proposed_objects with real poses/connections and check issues; no fabricated throughput"
  },
  "accepted_unit_resolution": {
    "seed_item_type": "carton",
    "seed_declared_unit": "piece",
    "display_label": "合格箱数",
    "canonical": "Quantity.unit and AcceptanceScope.unit must be actual ItemType unit; carton is a product/count label unless separately registered as a convertible UnitId",
    "bundle": "bundle unit piece counts bundles only; use actual content/carton relation once at declared destination/stage to count accepted carton pieces"
  }
}
