  },
  "service_binding": {
    "fields": [
      "source_ref",
      "connection_ref",
      "device_ref",
      "phase_ref",
      "incremental_demand",
      "unit",
      "reference_conditions",
      "required_properties",
      "interruption_policy"
    ],
    "ownership": "simulation acquires all phase requirements atomically; resources category"
  },
  "service_event": {
    "fields": [
      "at_ms",
      "source_ref",
      "new_capacity",
      "new_availability"
    ],
    "event_order": "close previous progress/completions, apply availability and capacity, acquire new stages"
  },
  "current_result": null
}
