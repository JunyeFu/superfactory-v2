    "meaning": "one calendar reference; displays use different units, not independent clocks"
  },
  "readiness_package": {
    "fields": [
      "id",
      "target_ref",
      "required_artifact_bindings",
      "construction_task_refs",
      "required_service_bindings",
      "readiness_conditions",
