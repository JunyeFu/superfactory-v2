      "release_decision_ref"
    ],
    "states": [
      "draft",
      "awaiting_conditions",
      "awaiting_acceptance",
      "available_in_accepted_scope"
    ],
    "decision_scope": "simulation/declared or actual evidence must be explicit"
  },
  "construction_task": {
    "fields": [
      "id",
      "target_ref",
      "predecessors",
      "planned_start_project_ms",
      "planned_finish_project_ms",
      "progress_source",
      "completion_decision"
    ],
    "crew_work_hours": "explicit data or null; calendar duration is not paid labor"
