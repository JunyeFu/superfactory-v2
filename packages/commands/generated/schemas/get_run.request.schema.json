{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Request",
  "type": "object",
  "properties": {
    "api_version": {
      "$ref": "#/$defs/ApiVersion"
    },
    "operation": {
      "$ref": "#/$defs/GetRunTag"
    },
    "params": {
      "$ref": "#/$defs/GetRunParams"
    },
    "project_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProjectId"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_id": {
      "$ref": "#/$defs/ObjectId"
    },
    "scope": {
      "$ref": "#/$defs/ApiScope"
    }
  },
  "additionalProperties": false,
  "required": [
    "api_version",
    "request_id",
    "project_id",
    "scope",
    "operation",
    "params"
  ],
  "$defs": {
    "ApiScope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "workspace"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "project"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/ModuleId"
            },
            "kind": {
              "type": "string",
              "const": "definition_draft"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "data"
          ]
        }
      ]
    },
    "ApiVersion": {
      "type": "string",
      "enum": [
        "0.1"
      ]
    },
    "GetRunParams": {
      "type": "object",
      "properties": {
        "query": {
          "$ref": "#/$defs/RunQuery"
        },
        "run_id": {
          "$ref": "#/$defs/RunId"
        }
      },
      "additionalProperties": false,
      "required": [
        "run_id",
        "query"
      ]
    },
    "GetRunTag": {
      "type": "string",
      "enum": [
        "get_run"
      ]
    },
    "IntervalMs": {
      "type": "object",
      "properties": {
        "end_ms": {
          "$ref": "#/$defs/SafeUint"
        },
        "start_ms": {
          "$ref": "#/$defs/SafeUint"
        }
      },
      "additionalProperties": false,
      "required": [
        "start_ms",
        "end_ms"
      ]
    },
    "ModuleId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "ObjectId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "ObjectKind": {
      "type": "string",
      "enum": [
        "project",
        "scenario",
        "run",
        "definition_draft",
        "packaging_job",
        "asset",
        "native_scene",
        "item_type",
        "item",
        "location",
        "hall",
        "line",
        "device",
        "resource",
        "calendar",
        "product",
        "bom",
        "route",
        "connection",
        "order",
        "task",
        "job",
        "supply",
        "transport",
        "artifact",
        "module",
        "report"
      ]
    },
    "ObjectRef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ObjectId"
        },
        "kind": {
          "$ref": "#/$defs/ObjectKind"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ]
    },
    "PageRequest": {
      "type": "object",
      "properties": {
        "after_index": {
          "anyOf": [
            {
              "$ref": "#/$defs/SafeUint"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "$ref": "#/$defs/SafeUint"
        }
      },
      "additionalProperties": false,
      "required": [
        "limit"
      ]
    },
    "ProjectId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "RunId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "RunQuery": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "summary"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "interval": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/IntervalMs"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "page": {
                  "$ref": "#/$defs/PageRequest"
                }
              },
              "additionalProperties": false,
              "required": [
                "page"
              ]
            },
            "kind": {
              "type": "string",
              "const": "events"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "at_ms": {
                  "$ref": "#/$defs/SafeUint"
                },
                "objects": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/ObjectRef"
                  }
                },
                "page": {
                  "$ref": "#/$defs/PageRequest"
                }
              },
              "additionalProperties": false,
              "required": [
                "at_ms",
                "objects",
                "page"
              ]
            },
            "kind": {
              "type": "string",
              "const": "objects_at"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "data"
          ]
        },
        {
          "description": "Canonical RunResult: frozen execution refs, phase work intervals and computed frontier.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "full_result"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "SafeUint": {
      "type": "integer",
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0
    }
  }
}
