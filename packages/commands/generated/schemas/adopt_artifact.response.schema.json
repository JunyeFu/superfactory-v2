{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Response",
  "type": "object",
  "properties": {
    "api_version": {
      "$ref": "#/$defs/ApiVersion"
    },
    "context": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResponseContext"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "$ref": "#/$defs/ApiOutcome"
    },
    "request_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectId"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "api_version",
    "outcome"
  ],
  "$defs": {
    "ApiError": {
      "type": "object",
      "properties": {
        "actual_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/SafeUint"
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "expected_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/SafeUint"
            },
            {
              "type": "null"
            }
          ]
        },
        "field_errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ApiFieldError"
          }
        },
        "message": {
          "type": "string"
        },
        "object_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectRef"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "object_refs",
        "field_errors"
      ]
    },
    "ApiFieldError": {
      "type": "object",
      "properties": {
        "pointer": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "pointer",
        "reason"
      ]
    },
    "ApiOutcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/BindingCommit"
            },
            "status": {
              "type": "string",
              "const": "ok"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/ApiError"
            },
            "status": {
              "type": "string",
              "const": "error"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/ManagedJsonResultRef"
            },
            "status": {
              "type": "string",
              "const": "managed"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "data"
          ]
        }
      ]
    },
    "ApiVersion": {
      "type": "string",
      "enum": [
        "0.1"
      ]
    },
    "ArtifactId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "BindingCommit": {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "#/$defs/ConsumerBinding"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Issue"
          }
        },
        "new_revision": {
          "$ref": "#/$defs/SafeUint"
        },
        "previous_revision": {
          "$ref": "#/$defs/SafeUint"
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        }
      },
      "additionalProperties": false,
      "required": [
        "project_id",
        "previous_revision",
        "new_revision",
        "binding",
        "issues"
      ]
    },
    "CapabilityPurpose": {
      "type": "string",
      "enum": [
        "execution",
        "preview",
        "adoption",
        "redistribution",
        "complete_conclusion"
      ]
    },
    "ConsumerBinding": {
      "type": "object",
      "properties": {
        "acceptance_ref": {
          "$ref": "#/$defs/ObjectId"
        },
        "artifact_ref": {
          "$ref": "#/$defs/ArtifactId"
        },
        "consumer_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "expected_subject_revision": {
          "$ref": "#/$defs/SubjectRevisionId"
        },
        "id": {
          "$ref": "#/$defs/ObjectId"
        },
        "mode": {
          "$ref": "#/$defs/ProfessionalMode"
        },
        "operation_ref": {
          "$ref": "#/$defs/ModuleRef"
        },
        "requested_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_payload": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "consumer_ref",
        "operation_ref",
        "artifact_ref",
        "expected_subject_revision",
        "required_payload",
        "requested_scope",
        "acceptance_ref",
        "mode"
      ]
    },
    "DefinitionScopeIdentity": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ModuleId"
        },
        "revision": {
          "$ref": "#/$defs/SafeUint"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ]
    },
    "EditScope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/ProjectId"
            },
            "kind": {
              "type": "string",
              "const": "project"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/DefinitionScopeIdentity"
            },
            "kind": {
              "type": "string",
              "const": "definition_draft"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "data"
          ]
        }
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "NoActiveProject",
        "UnsupportedCapability",
        "InvalidInput",
        "MissingReference",
        "RevisionConflict",
        "PermissionDenied",
        "ComputationFailed",
        "Cancelled",
        "UnsupportedSchema",
        "IoFailure"
      ]
    },
    "Issue": {
      "type": "object",
      "properties": {
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapabilityPurpose"
          }
        },
        "code": {
          "type": "string"
        },
        "field_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "object_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "blocks"
      ]
    },
    "ManagedJsonResultRef": {
      "type": "object",
      "properties": {
        "byte_length": {
          "$ref": "#/$defs/SafeUint"
        },
        "response_schema_ref": {
          "type": "string"
        },
        "result_id": {
          "$ref": "#/$defs/ObjectId"
        }
      },
      "additionalProperties": false,
      "required": [
        "result_id",
        "response_schema_ref",
        "byte_length"
      ]
    },
    "ModuleId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "ModuleRef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ModuleId"
        },
        "version": {
          "$ref": "#/$defs/VersionId"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ]
    },
    "ObjectId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "ObjectKind": {
      "type": "string",
      "enum": [
        "project",
        "scenario",
        "run",
        "definition_draft",
        "packaging_job",
        "asset",
        "native_scene",
        "item_type",
        "item",
        "location",
        "hall",
        "line",
        "device",
        "resource",
        "calendar",
        "product",
        "bom",
        "route",
        "connection",
        "order",
        "task",
        "job",
        "supply",
        "transport",
        "artifact",
        "module",
        "report"
      ]
    },
    "ObjectRef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ObjectId"
        },
        "kind": {
          "$ref": "#/$defs/ObjectKind"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ]
    },
    "ProfessionalMode": {
      "type": "string",
      "enum": [
        "declared_process",
        "calculated_nominal",
        "software_in_loop"
      ]
    },
    "ProjectId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "ResponseContext": {
      "type": "object",
      "properties": {
        "host_instance_id": {
          "$ref": "#/$defs/ObjectId"
        },
        "project_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectId"
            },
            {
              "type": "null"
            }
          ]
        },
        "project_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/SafeUint"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/EditScope"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/SafeUint"
            },
            {
              "type": "null"
            }
          ]
        },
        "session_id": {
          "$ref": "#/$defs/ObjectId"
        }
      },
      "additionalProperties": false,
      "required": [
        "host_instance_id",
        "session_id"
      ]
    },
    "SafeUint": {
      "type": "integer",
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0
    },
    "SubjectRevisionId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "VersionId": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    }
  }
}
