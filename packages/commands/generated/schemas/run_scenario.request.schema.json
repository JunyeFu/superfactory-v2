{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Request",
  "type": "object",
  "properties": {
    "api_version": {
      "$ref": "#/$defs/ApiVersion"
    },
    "operation": {
      "$ref": "#/$defs/RunScenarioTag"
    },
    "params": {
      "$ref": "#/$defs/RunScenarioParams"
    },
    "project_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProjectId"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_id": {
      "$ref": "#/$defs/ObjectId"
    },
    "scope": {
      "$ref": "#/$defs/ApiScope"
    }
  },
  "additionalProperties": false,
  "required": [
    "api_version",
    "request_id",
    "project_id",
    "scope",
    "operation",
    "params"
  ],
  "$defs": {
    "AcceptanceScope": {
      "type": "object",
      "properties": {
        "destination": {
          "$ref": "#/$defs/ObjectId"
        },
        "product_ref": {
          "$ref": "#/$defs/SubjectRevisionRef"
        },
        "stage": {
          "$ref": "#/$defs/AcceptanceStage"
        },
        "unit": {
          "$ref": "#/$defs/UnitId"
        }
      },
      "additionalProperties": false,
      "required": [
        "product_ref",
        "unit",
        "destination",
        "stage"
      ]
    },
    "AcceptanceStage": {
      "type": "string",
      "enum": [
        "factory_released",
        "received",
        "unloaded_and_released"
      ]
    },
    "AllocationMode": {
      "type": "string",
      "enum": [
        "soft_plan",
        "hard_reserved",
        "committed"
      ]
    },
    "ApiScope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "workspace"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "project"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/ModuleId"
            },
            "kind": {
              "type": "string",
              "const": "definition_draft"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "data"
          ]
        }
      ]
    },
    "ApiVersion": {
      "type": "string",
      "enum": [
        "0.1"
      ]
    },
    "ArrivalPlan": {
      "type": "object",
      "properties": {
        "at_ms": {
          "$ref": "#/$defs/SafeUint"
        },
        "destination": {
          "$ref": "#/$defs/ObjectId"
        },
        "id": {
          "$ref": "#/$defs/ObjectId"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InitialItem"
          }
        },
        "release_policy": {
          "$ref": "#/$defs/ReleasePolicy"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "at_ms",
        "destination",
        "items",
        "release_policy"
      ]
    },
    "ArtifactId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "CanonicalTimeUnit": {
      "type": "string",
      "enum": [
        "millisecond"
      ]
    },
    "CapabilityPurpose": {
      "type": "string",
      "enum": [
        "execution",
        "preview",
        "adoption",
        "redistribution",
        "complete_conclusion"
      ]
    },
    "CostBasis": {
      "type": "string",
      "enum": [
        "consumed_material",
        "occupied_time",
        "paid_calendar",
        "batch_transport",
        "explicit_disposal"
      ]
    },
    "CostInput": {
      "type": "object",
      "properties": {
        "basis": {
          "$ref": "#/$defs/CostBasis"
        },
        "component": {
          "type": "string"
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/ObjectId"
        },
        "includes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "object_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "rate": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecimalAmount"
            },
            {
              "type": "null"
            }
          ]
        },
        "rate_quantity": {
          "$ref": "#/$defs/Quantity"
        },
        "source": {
          "$ref": "#/$defs/ParameterSource"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "object_ref",
        "component",
        "basis",
        "rate_quantity",
        "includes",
        "source"
      ]
    },
    "DecimalAmount": {
      "type": "object",
      "properties": {
        "coefficient": {
          "$ref": "#/$defs/SafeUint"
        },
        "decimal_places": {
          "$ref": "#/$defs/DecimalPlaces"
        }
      },
      "additionalProperties": false,
      "required": [
        "coefficient",
        "decimal_places"
      ]
    },
    "DecimalPlaces": {
      "type": "integer",
      "format": "uint8",
      "maximum": 9,
      "minimum": 0
    },
    "DecisionSource": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "human_statement"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/ObjectId"
            },
            "kind": {
              "type": "string",
              "const": "scheduled_preset"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/ArtifactId"
            },
            "kind": {
              "type": "string",
              "const": "provider_result"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "data"
          ]
        }
      ]
    },
    "DurationValue": {
      "type": "object",
      "properties": {
        "basis": {
          "$ref": "#/$defs/SourceBasis"
        },
        "source_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectId"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "$ref": "#/$defs/CanonicalTimeUnit"
        },
        "value": {
          "$ref": "#/$defs/SafeUint"
        }
      },
      "additionalProperties": false,
      "required": [
        "value",
        "unit",
        "basis"
      ]
    },
    "FactoryGenerationGoal": {
      "type": "object",
      "properties": {
        "acceptance_scope": {
          "$ref": "#/$defs/AcceptanceScope"
        },
        "accepted_quantity_per_day": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "additional_acceptance_scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AcceptanceScope"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Issue"
          }
        },
        "existing_equipment": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectRef"
          }
        },
        "industry": {
          "type": "string"
        },
        "observation_window": {
          "$ref": "#/$defs/WindowMs"
        },
        "product_family": {
          "type": "string"
        },
        "product_specification_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/SubjectRevisionRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "production_calendar_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectId"
            },
            {
              "type": "null"
            }
          ]
        },
        "site_envelope": {
          "$ref": "#/$defs/SiteEnvelope"
        }
      },
      "additionalProperties": false,
      "required": [
        "industry",
        "product_family",
        "acceptance_scope",
        "observation_window",
        "site_envelope",
        "existing_equipment",
        "constraints"
      ]
    },
    "FiniteNumber": {
      "type": "number",
      "format": "double"
    },
    "HolderRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/ObjectId"
            },
            "kind": {
              "type": "string",
              "const": "location"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/ObjectId"
            },
            "kind": {
              "type": "string",
              "const": "job"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/ObjectId"
            },
            "kind": {
              "type": "string",
              "const": "transport"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/ObjectId"
            },
            "kind": {
              "type": "string",
              "const": "container"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ]
        }
      ]
    },
    "InitialConditions": {
      "type": "object",
      "properties": {
        "declared_quality_decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QualityDecision"
          }
        },
        "initial_setup_families": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[^\\u0000]+$": {
              "type": "string"
            }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InitialItem"
          }
        },
        "material_allocations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MaterialAllocation"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "items",
        "initial_setup_families",
        "declared_quality_decisions",
        "material_allocations"
      ]
    },
    "InitialItem": {
      "type": "object",
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectId"
          }
        },
        "contents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectId"
          }
        },
        "holder": {
          "$ref": "#/$defs/HolderRef"
        },
        "id": {
          "$ref": "#/$defs/ObjectId"
        },
        "item_type_ref": {
          "$ref": "#/$defs/SubjectRevisionRef"
        },
        "quality": {
          "$ref": "#/$defs/QualityState"
        },
        "quantity": {
          "$ref": "#/$defs/Quantity"
        },
        "source": {
          "$ref": "#/$defs/SourceBasis"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "item_type_ref",
        "quantity",
        "holder",
        "quality",
        "components",
        "contents",
        "source"
      ]
    },
    "InspectionPreset": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ObjectId"
        },
        "inspection_module": {
          "$ref": "#/$defs/ModuleRef"
        },
        "item_or_ancestor": {
          "$ref": "#/$defs/ObjectId"
        },
        "match_kind": {
          "$ref": "#/$defs/QualityMatchKind"
        },
        "results": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/TypedValue"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "item_or_ancestor",
        "match_kind",
        "inspection_module",
        "results"
      ]
    },
    "IntervalMs": {
      "type": "object",
      "properties": {
        "end_ms": {
          "$ref": "#/$defs/SafeUint"
        },
        "start_ms": {
          "$ref": "#/$defs/SafeUint"
        }
      },
      "additionalProperties": false,
      "required": [
        "start_ms",
        "end_ms"
      ]
    },
    "Issue": {
      "type": "object",
      "properties": {
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapabilityPurpose"
          }
        },
        "code": {
          "type": "string"
        },
        "field_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "object_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "blocks"
      ]
    },
    "LayoutRegion": {
      "type": "object",
      "properties": {
        "clearance_m": {
          "anyOf": [
            {
              "$ref": "#/$defs/FiniteNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "$ref": "#/$defs/ObjectId"
        },
        "kind": {
          "$ref": "#/$defs/LayoutRegionKind"
        },
        "polygon_m": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Vec2"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "polygon_m",
        "kind"
      ]
    },
    "LayoutRegionKind": {
      "type": "string",
      "enum": [
        "usable",
        "keep_out",
        "static_lane"
      ]
    },
    "MaterialAllocation": {
      "type": "object",
      "properties": {
        "demand_ref": {
          "$ref": "#/$defs/ObjectId"
        },
        "id": {
          "$ref": "#/$defs/ObjectId"
        },
        "item_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectId"
          }
        },
        "mode": {
          "$ref": "#/$defs/AllocationMode"
        },
        "quantity": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "demand_ref",
        "item_refs",
        "quantity",
        "mode"
      ]
    },
    "ModuleId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "ModuleRef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ModuleId"
        },
        "version": {
          "$ref": "#/$defs/VersionId"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ]
    },
    "ObjectId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "ObjectKind": {
      "type": "string",
      "enum": [
        "project",
        "scenario",
        "run",
        "definition_draft",
        "packaging_job",
        "asset",
        "native_scene",
        "item_type",
        "item",
        "location",
        "hall",
        "line",
        "device",
        "resource",
        "calendar",
        "product",
        "bom",
        "route",
        "connection",
        "order",
        "task",
        "job",
        "supply",
        "transport",
        "artifact",
        "module",
        "report"
      ]
    },
    "ObjectRef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ObjectId"
        },
        "kind": {
          "$ref": "#/$defs/ObjectKind"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ]
    },
    "OrderAllocation": {
      "type": "object",
      "properties": {
        "order_id": {
          "$ref": "#/$defs/ObjectId"
        },
        "quantity": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "additionalProperties": false,
      "required": [
        "order_id",
        "quantity"
      ]
    },
    "OrderLine": {
      "type": "object",
      "properties": {
        "acceptance_stage": {
          "$ref": "#/$defs/AcceptanceStage"
        },
        "allow_partial": {
          "type": "boolean"
        },
        "destination": {
          "$ref": "#/$defs/ObjectId"
        },
        "due_at_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/SafeUint"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "$ref": "#/$defs/ObjectId"
        },
        "priority": {
          "type": "integer",
          "format": "int32"
        },
        "product_ref": {
          "$ref": "#/$defs/SubjectRevisionRef"
        },
        "quantity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "release_at_ms": {
          "$ref": "#/$defs/SafeUint"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "product_ref",
        "release_at_ms",
        "destination",
        "acceptance_stage",
        "allow_partial",
        "priority"
      ]
    },
    "ParameterOverride": {
      "type": "object",
      "properties": {
        "basis": {
          "$ref": "#/$defs/SourceBasis"
        },
        "path": {
          "type": "string"
        },
        "source_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectId"
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "$ref": "#/$defs/ObjectRef"
        },
        "value": {
          "$ref": "#/$defs/TypedValue"
        }
      },
      "additionalProperties": false,
      "required": [
        "target",
        "path",
        "value",
        "basis"
      ]
    },
    "ParameterSource": {
      "type": "object",
      "properties": {
        "basis": {
          "$ref": "#/$defs/SourceBasis"
        },
        "field_path": {
          "type": "string"
        },
        "source_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectId"
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "$ref": "#/$defs/ObjectRef"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/TypedValue"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "target",
        "field_path",
        "basis"
      ]
    },
    "ProductionTask": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ObjectId"
        },
        "order_allocations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OrderAllocation"
          }
        },
        "planned_quantity": {
          "$ref": "#/$defs/Quantity"
        },
        "priority": {
          "type": "integer",
          "format": "int32"
        },
        "release_at_ms": {
          "$ref": "#/$defs/SafeUint"
        },
        "routing_ref": {
          "$ref": "#/$defs/SubjectRevisionRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "routing_ref",
        "order_allocations",
        "planned_quantity",
        "release_at_ms",
        "priority"
      ]
    },
    "ProjectId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "QualityDecision": {
      "type": "object",
      "properties": {
        "decision_source": {
          "$ref": "#/$defs/DecisionSource"
        },
        "disposition": {
          "$ref": "#/$defs/QualityDisposition"
        },
        "effective_at_ms": {
          "$ref": "#/$defs/SafeUint"
        },
        "id": {
          "$ref": "#/$defs/ObjectId"
        },
        "inspection_ref": {
          "$ref": "#/$defs/ModuleRef"
        },
        "item_ref": {
          "$ref": "#/$defs/ObjectId"
        },
        "observed_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/TypedValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_kind": {
          "$ref": "#/$defs/QualitySourceKind"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "item_ref",
        "inspection_ref",
        "source_kind",
        "disposition",
        "effective_at_ms",
        "decision_source"
      ]
    },
    "QualityDisposition": {
      "type": "string",
      "enum": [
        "pending",
        "release",
        "reinspect",
        "rework",
        "isolate",
        "scrap"
      ]
    },
    "QualityMatchKind": {
      "type": "string",
      "enum": [
        "exact_item",
        "ancestor",
        "batch"
      ]
    },
    "QualitySourceKind": {
      "type": "string",
      "enum": [
        "preset",
        "tool_result",
        "manual"
      ]
    },
    "QualityState": {
      "type": "string",
      "enum": [
        "unchecked",
        "pending",
        "released",
        "rejected"
      ]
    },
    "Quantity": {
      "type": "object",
      "properties": {
        "unit": {
          "$ref": "#/$defs/UnitId"
