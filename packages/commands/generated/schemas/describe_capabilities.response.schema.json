{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Response",
  "type": "object",
  "properties": {
    "api_version": {
      "$ref": "#/$defs/ApiVersion"
    },
    "context": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResponseContext"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "$ref": "#/$defs/ApiOutcome"
    },
    "request_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectId"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "api_version",
    "outcome"
  ],
  "$defs": {
    "ApiCategory": {
      "type": "string",
      "enum": [
        "items",
        "devices",
        "resources",
        "tasks",
        "operations",
        "transport",
        "templates",
        "professional",
        "media"
      ]
    },
    "ApiError": {
      "type": "object",
      "properties": {
        "actual_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/SafeUint"
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "expected_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/SafeUint"
            },
            {
              "type": "null"
            }
          ]
        },
        "field_errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ApiFieldError"
          }
        },
        "message": {
          "type": "string"
        },
        "object_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectRef"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "object_refs",
        "field_errors"
      ]
    },
    "ApiFieldError": {
      "type": "object",
      "properties": {
        "pointer": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "pointer",
        "reason"
      ]
    },
    "ApiOutcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/CapabilityCatalog"
            },
            "status": {
              "type": "string",
              "const": "ok"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/ApiError"
            },
            "status": {
              "type": "string",
              "const": "error"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/ManagedJsonResultRef"
            },
            "status": {
              "type": "string",
              "const": "managed"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "data"
          ]
        }
      ]
    },
    "ApiScope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "workspace"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "project"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/ModuleId"
            },
            "kind": {
              "type": "string",
              "const": "definition_draft"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "data"
          ]
        }
      ]
    },
    "ApiVersion": {
      "type": "string",
      "enum": [
        "0.1"
      ]
    },
    "CapabilityCatalog": {
      "type": "object",
      "properties": {
        "api_version": {
          "$ref": "#/$defs/ApiVersion"
        },
        "available_command_kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "category_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ApiCategory"
          }
        },
        "implemented_operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OperationCapability"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Issue"
          }
        },
        "max_ipc_frame_bytes": {
          "$ref": "#/$defs/SafeUint"
        },
        "media_kinds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PresentationKind"
          }
        },
        "native_primitives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "providers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProviderCapability"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "api_version",
        "implemented_operations",
        "available_command_kinds",
        "providers",
        "category_ids",
        "media_kinds",
        "native_primitives",
        "max_ipc_frame_bytes",
        "limitations"
      ]
    },
    "CapabilityPurpose": {
      "type": "string",
      "enum": [
        "execution",
        "preview",
        "adoption",
        "redistribution",
        "complete_conclusion"
      ]
    },
    "DefinitionScopeIdentity": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ModuleId"
        },
        "revision": {
          "$ref": "#/$defs/SafeUint"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ]
    },
    "EditScope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/ProjectId"
            },
            "kind": {
              "type": "string",
              "const": "project"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/DefinitionScopeIdentity"
            },
            "kind": {
              "type": "string",
              "const": "definition_draft"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "data"
          ]
        }
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "NoActiveProject",
        "UnsupportedCapability",
        "InvalidInput",
        "MissingReference",
        "RevisionConflict",
        "PermissionDenied",
        "ComputationFailed",
        "Cancelled",
        "UnsupportedSchema",
        "IoFailure"
      ]
    },
    "Issue": {
      "type": "object",
      "properties": {
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapabilityPurpose"
          }
        },
        "code": {
          "type": "string"
        },
        "field_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "object_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "blocks"
      ]
    },
    "ManagedJsonResultRef": {
      "type": "object",
      "properties": {
        "byte_length": {
          "$ref": "#/$defs/SafeUint"
        },
        "response_schema_ref": {
          "type": "string"
        },
        "result_id": {
          "$ref": "#/$defs/ObjectId"
        }
      },
      "additionalProperties": false,
      "required": [
        "result_id",
        "response_schema_ref",
        "byte_length"
      ]
    },
    "ModuleId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "ObjectId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "ObjectKind": {
      "type": "string",
      "enum": [
        "project",
        "scenario",
        "run",
        "definition_draft",
        "packaging_job",
        "asset",
        "native_scene",
        "item_type",
        "item",
        "location",
        "hall",
        "line",
        "device",
        "resource",
        "calendar",
        "product",
        "bom",
        "route",
        "connection",
        "order",
        "task",
        "job",
        "supply",
        "transport",
        "artifact",
        "module",
        "report"
      ]
    },
    "ObjectRef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ObjectId"
        },
        "kind": {
          "$ref": "#/$defs/ObjectKind"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ]
    },
    "OperationCapability": {
      "type": "object",
      "properties": {
        "allowed_scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ApiScope"
          }
        },
        "available_controls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TaskControlAction"
          }
        },
        "input_schema_ref": {
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/OperationName"
        },
        "output_schema_ref": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "input_schema_ref",
        "output_schema_ref",
        "allowed_scopes",
        "available_controls"
      ]
    },
    "OperationName": {
      "type": "string",
      "enum": [
        "describe_capabilities",
        "get_context",
        "get_object",
        "apply_commands",
        "render_view",
        "run_scenario",
        "get_run",
        "compare_runs",
        "compute_packaging",
        "get_task",
        "cancel_task",
        "adopt_artifact",
        "import_package",
        "save_project",
        "export_package",
        "export_evaluation",
        "query_module_library",
        "check_factory_draft",
        "read_cloud_production",
        "start_execution_session",
        "get_execution_snapshot",
        "control_execution_session",
        "apply_device_receipt",
        "get_execution_cloud_work",
        "acknowledge_execution_cloud_work",
        "apply_device_observation",
        "read_execution_view",
        "export_execution_report",
        "export_cloud_data"
      ]
    },
    "PresentationKind": {
      "type": "string",
      "enum": [
        "image",
        "image_sequence",
        "gif",
        "model",
        "native_scene"
      ]
    },
    "ProfessionalMode": {
      "type": "string",
      "enum": [
        "declared_process",
        "calculated_nominal",
        "software_in_loop"
      ]
    },
    "ProjectId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "ProviderCapability": {
      "type": "object",
      "properties": {
        "available_modes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProfessionalMode"
          }
        },
        "producer_status": {
          "$ref": "#/$defs/ProviderStatus"
        },
        "provider_id": {
          "$ref": "#/$defs/ModuleId"
        },
        "supported_input_schema": {
          "type": "string"
        },
        "supported_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "provider_id",
        "available_modes",
        "producer_status",
        "supported_input_schema",
        "supported_scope"
      ]
    },
    "ProviderStatus": {
      "type": "string",
      "enum": [
        "not_implemented",
        "available",
        "unavailable"
      ]
    },
    "ResponseContext": {
      "type": "object",
      "properties": {
        "host_instance_id": {
          "$ref": "#/$defs/ObjectId"
        },
        "project_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectId"
            },
            {
              "type": "null"
            }
          ]
        },
        "project_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/SafeUint"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/EditScope"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/SafeUint"
            },
            {
              "type": "null"
            }
          ]
        },
        "session_id": {
          "$ref": "#/$defs/ObjectId"
        }
      },
      "additionalProperties": false,
      "required": [
        "host_instance_id",
        "session_id"
      ]
    },
    "SafeUint": {
      "type": "integer",
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0
    },
    "TaskControlAction": {
      "type": "string",
      "enum": [
        "cancel",
        "pause_calculation",
        "resume_calculation",
        "step_next_timestamp"
      ]
    }
  }
}
