{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Request",
  "type": "object",
  "properties": {
    "api_version": {
      "$ref": "#/$defs/ApiVersion"
    },
    "operation": {
      "$ref": "#/$defs/CompareRunsTag"
    },
    "params": {
      "$ref": "#/$defs/CompareRunsParams"
    },
    "project_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProjectId"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_id": {
      "$ref": "#/$defs/ObjectId"
    },
    "scope": {
      "$ref": "#/$defs/ApiScope"
    }
  },
  "additionalProperties": false,
  "required": [
    "api_version",
    "request_id",
    "project_id",
    "scope",
    "operation",
    "params"
  ],
  "$defs": {
    "AcceptanceScope": {
      "type": "object",
      "properties": {
        "destination": {
          "$ref": "#/$defs/ObjectId"
        },
        "product_ref": {
          "$ref": "#/$defs/SubjectRevisionRef"
        },
        "stage": {
          "$ref": "#/$defs/AcceptanceStage"
        },
        "unit": {
          "$ref": "#/$defs/UnitId"
        }
      },
      "additionalProperties": false,
      "required": [
        "product_ref",
        "unit",
        "destination",
        "stage"
      ]
    },
    "AcceptanceStage": {
      "type": "string",
      "enum": [
        "factory_released",
        "received",
        "unloaded_and_released"
      ]
    },
    "ApiScope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "workspace"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "project"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/ModuleId"
            },
            "kind": {
              "type": "string",
              "const": "definition_draft"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "data"
          ]
        }
      ]
    },
    "ApiVersion": {
      "type": "string",
      "enum": [
        "0.1"
      ]
    },
    "CompareRunsParams": {
      "type": "object",
      "properties": {
        "metric_scope": {
          "$ref": "#/$defs/MetricScope"
        },
        "run_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RunId"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "run_ids",
        "metric_scope"
      ]
    },
    "CompareRunsTag": {
      "type": "string",
      "enum": [
        "compare_runs"
      ]
    },
    "MetricKey": {
      "type": "string",
      "enum": [
        "accepted_quantity",
        "completion_time",
        "waiting_time",
        "resource_utilization",
        "unit_cost",
        "rework_quantity"
      ]
    },
    "MetricScope": {
      "type": "object",
      "properties": {
        "acceptance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AcceptanceScope"
          }
        },
        "keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MetricKey"
          }
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectRef"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "keys",
        "objects",
        "acceptance"
      ]
    },
    "ModuleId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "ObjectId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "ObjectKind": {
      "type": "string",
      "enum": [
        "project",
        "scenario",
        "run",
        "definition_draft",
        "packaging_job",
        "asset",
        "native_scene",
        "item_type",
        "item",
        "location",
        "hall",
        "line",
        "device",
        "resource",
        "calendar",
        "product",
        "bom",
        "route",
        "connection",
        "order",
        "task",
        "job",
        "supply",
        "transport",
        "artifact",
        "module",
        "report"
      ]
    },
    "ObjectRef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ObjectId"
        },
        "kind": {
          "$ref": "#/$defs/ObjectKind"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ]
    },
    "ProjectId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "RunId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "SubjectRevisionId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "SubjectRevisionRef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ObjectId"
        },
        "revision": {
          "$ref": "#/$defs/SubjectRevisionId"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ]
    },
    "UnitId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    }
  }
}
