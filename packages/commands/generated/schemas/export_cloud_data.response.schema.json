{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Response",
  "type": "object",
  "properties": {
    "api_version": {
      "$ref": "#/$defs/ApiVersion"
    },
    "context": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResponseContext"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "$ref": "#/$defs/ApiOutcome"
    },
    "request_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectId"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "api_version",
    "outcome"
  ],
  "$defs": {
    "ApiError": {
      "type": "object",
      "properties": {
        "actual_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/SafeUint"
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "expected_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/SafeUint"
            },
            {
              "type": "null"
            }
          ]
        },
        "field_errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ApiFieldError"
          }
        },
        "message": {
          "type": "string"
        },
        "object_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectRef"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "object_refs",
        "field_errors"
      ]
    },
    "ApiFieldError": {
      "type": "object",
      "properties": {
        "pointer": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "pointer",
        "reason"
      ]
    },
    "ApiOutcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/ExportingTaskHandle"
            },
            "status": {
              "type": "string",
              "const": "ok"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/ApiError"
            },
            "status": {
              "type": "string",
              "const": "error"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/ManagedJsonResultRef"
            },
            "status": {
              "type": "string",
              "const": "managed"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "data"
          ]
        }
      ]
    },
    "ApiVersion": {
      "type": "string",
      "enum": [
        "0.1"
      ]
    },
    "CapabilityPurpose": {
      "type": "string",
      "enum": [
        "execution",
        "preview",
        "adoption",
        "redistribution",
        "complete_conclusion"
      ]
    },
    "ComputationStatus": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "paused",
        "cancel_requested",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "DefinitionScopeIdentity": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ModuleId"
        },
        "revision": {
          "$ref": "#/$defs/SafeUint"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ]
    },
    "DocumentKind": {
      "type": "string",
      "enum": [
        "artifact_record",
        "project",
        "scenario",
        "module",
        "template",
        "generation_profile",
        "presentation",
        "packaging_job",
        "packaging_result",
        "run_input",
        "run_result",
        "evaluation",
        "execution_archive",
        "asset"
      ]
    },
    "EditScope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/ProjectId"
            },
            "kind": {
              "type": "string",
              "const": "project"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/DefinitionScopeIdentity"
            },
            "kind": {
              "type": "string",
              "const": "definition_draft"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "data"
          ]
        }
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "NoActiveProject",
        "UnsupportedCapability",
        "InvalidInput",
        "MissingReference",
        "RevisionConflict",
        "PermissionDenied",
        "ComputationFailed",
        "Cancelled",
        "UnsupportedSchema",
        "IoFailure"
      ]
    },
    "ExportingTaskHandle": {
      "type": "object",
      "properties": {
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/Issue"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "$ref": "#/$defs/TaskId"
        },
        "input_revision": {
          "$ref": "#/$defs/SafeUint"
        },
        "kind": {
          "$ref": "#/$defs/ExportingTaskHandleKind"
        },
        "progress": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskProgress"
            },
            {
              "type": "null"
            }
          ]
        },
        "result_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/FileRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "$ref": "#/$defs/TaskScope"
        },
        "state": {
          "$ref": "#/$defs/ComputationStatus"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "scope",
        "kind",
        "state",
        "input_revision",
        "progress",
        "result_ref",
        "failure"
      ]
    },
    "ExportingTaskHandleKind": {
      "type": "string",
      "enum": [
        "exporting"
      ]
    },
    "FileRef": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/DocumentKind"
        },
        "path": {
          "$ref": "#/$defs/RelativeFilePath"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "kind"
      ]
    },
    "Issue": {
      "type": "object",
      "properties": {
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapabilityPurpose"
          }
        },
        "code": {
          "type": "string"
        },
        "field_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "object_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "blocks"
      ]
    },
    "ManagedJsonResultRef": {
      "type": "object",
      "properties": {
        "byte_length": {
          "$ref": "#/$defs/SafeUint"
        },
        "response_schema_ref": {
          "type": "string"
        },
        "result_id": {
          "$ref": "#/$defs/ObjectId"
        }
      },
      "additionalProperties": false,
      "required": [
        "result_id",
        "response_schema_ref",
        "byte_length"
      ]
    },
    "ModuleId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "ObjectId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "ObjectKind": {
      "type": "string",
      "enum": [
        "project",
        "scenario",
        "run",
        "definition_draft",
        "packaging_job",
        "asset",
        "native_scene",
        "item_type",
        "item",
        "location",
        "hall",
        "line",
        "device",
        "resource",
        "calendar",
        "product",
        "bom",
        "route",
        "connection",
        "order",
        "task",
        "job",
        "supply",
        "transport",
        "artifact",
        "module",
        "report"
      ]
    },
    "ObjectRef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ObjectId"
        },
        "kind": {
          "$ref": "#/$defs/ObjectKind"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ]
    },
    "ProjectId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "RelativeFilePath": {
      "type": "string",
      "pattern": "^(?!\\.{1,2}(?:/|$))[^/\\\\:\\u0000]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\:\\u0000]+)*$"
    },
    "ResponseContext": {
      "type": "object",
      "properties": {
        "host_instance_id": {
          "$ref": "#/$defs/ObjectId"
        },
        "project_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectId"
            },
            {
              "type": "null"
            }
          ]
        },
        "project_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/SafeUint"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/EditScope"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/SafeUint"
            },
            {
              "type": "null"
            }
          ]
        },
        "session_id": {
          "$ref": "#/$defs/ObjectId"
        }
      },
      "additionalProperties": false,
      "required": [
        "host_instance_id",
        "session_id"
      ]
    },
    "SafeUint": {
      "type": "integer",
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0
    },
    "TaskId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "TaskProgress": {
      "type": "object",
      "properties": {
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "type": "string"
        },
        "processed": {
          "$ref": "#/$defs/SafeUint"
        },
        "total": {
          "anyOf": [
            {
              "$ref": "#/$defs/SafeUint"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "phase",
        "processed"
      ]
    },
    "TaskScope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/ObjectId"
            },
            "kind": {
              "type": "string",
              "const": "workspace"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/EditScope"
            },
            "kind": {
              "type": "string",
              "const": "edit"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "data"
          ]
        }
      ]
    }
  }
}
