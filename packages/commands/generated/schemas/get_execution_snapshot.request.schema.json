{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HostReadRequest",
  "type": "object",
  "properties": {
    "api_version": {
      "$ref": "#/$defs/ApiVersion"
    },
    "operation": {
      "$ref": "#/$defs/HostReadRequestOperation"
    },
    "params": {
      "$ref": "#/$defs/HostReadRequestParams"
    },
    "project_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProjectId"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_id": {
      "$ref": "#/$defs/ObjectId"
    },
    "scope": {
      "$ref": "#/$defs/HostProjectScope"
    }
  },
  "additionalProperties": false,
  "required": [
    "api_version",
    "request_id",
    "project_id",
    "scope",
    "operation",
    "params"
  ],
  "$defs": {
    "ApiVersion": {
      "type": "string",
      "enum": [
        "0.1"
      ]
    },
    "ExecutionContractVersion": {
      "type": "string",
      "enum": [
        "sf.execution/2.0-draft11"
      ]
    },
    "ExecutionEpochId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "ExecutionIdentity": {
      "type": "object",
      "properties": {
        "execution_epoch_id": {
          "$ref": "#/$defs/ExecutionEpochId"
        },
        "host_context_session_id": {
          "$ref": "#/$defs/ObjectId"
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "session_id": {
          "$ref": "#/$defs/ExecutionSessionId"
        }
      },
      "additionalProperties": false,
      "required": [
        "session_id",
        "execution_epoch_id",
        "project_id",
        "host_context_session_id"
      ]
    },
    "ExecutionSessionId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "HostProjectScope": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/HostProjectScopeKind"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    "HostProjectScopeKind": {
      "type": "string",
      "enum": [
        "project"
      ]
    },
    "HostReadRequestOperation": {
      "type": "string",
      "enum": [
        "get_execution_snapshot"
      ]
    },
    "HostReadRequestParams": {
      "type": "object",
      "properties": {
        "execution_contract_version": {
          "$ref": "#/$defs/ExecutionContractVersion"
        },
        "identity": {
          "$ref": "#/$defs/ExecutionIdentity"
        },
        "selection": {
          "$ref": "#/$defs/SnapshotSelection"
        }
      },
      "additionalProperties": false,
      "required": [
        "execution_contract_version",
        "identity",
        "selection"
      ]
    },
    "ObjectId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "ProjectId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "SafeUint": {
      "type": "integer",
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0
    },
    "SnapshotSelection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "latest"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "execution_revision": {
              "$ref": "#/$defs/SafeUint"
            },
            "kind": {
              "type": "string",
              "const": "revision"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "execution_revision"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "cutoff"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    }
  }
}
