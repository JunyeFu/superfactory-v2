{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Request",
  "type": "object",
  "properties": {
    "api_version": {
      "$ref": "#/$defs/ApiVersion"
    },
    "operation": {
      "$ref": "#/$defs/ExportPackageTag"
    },
    "params": {
      "$ref": "#/$defs/ExportPackageParams"
    },
    "project_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProjectId"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_id": {
      "$ref": "#/$defs/ObjectId"
    },
    "scope": {
      "$ref": "#/$defs/ApiScope"
    }
  },
  "additionalProperties": false,
  "required": [
    "api_version",
    "request_id",
    "project_id",
    "scope",
    "operation",
    "params"
  ],
  "$defs": {
    "ApiScope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "workspace"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "project"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/ModuleId"
            },
            "kind": {
              "type": "string",
              "const": "definition_draft"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "data"
          ]
        }
      ]
    },
    "ApiVersion": {
      "type": "string",
      "enum": [
        "0.1"
      ]
    },
    "ArtifactId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "ExportPackageParams": {
      "type": "object",
      "properties": {
        "package_scope": {
          "$ref": "#/$defs/PackageSelection"
        },
        "revision": {
          "$ref": "#/$defs/SafeUint"
        },
        "selected_destination_ref": {
          "$ref": "#/$defs/SelectedFileRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "revision",
        "package_scope",
        "selected_destination_ref"
      ]
    },
    "ExportPackageTag": {
      "type": "string",
      "enum": [
        "export_package"
      ]
    },
    "FilePurpose": {
      "type": "string",
      "enum": [
        "import_package",
        "save_project",
        "export_package",
        "export_evaluation",
        "export_execution_report",
        "export_cloud_data"
      ]
    },
    "ModuleId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "ModuleRef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ModuleId"
        },
        "version": {
          "$ref": "#/$defs/VersionId"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ]
    },
    "ObjectId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "PackagePurpose": {
      "type": "string",
      "enum": [
        "private_project",
        "handoff_project",
        "private_module",
        "community_module"
      ]
    },
    "PackageSelection": {
      "type": "object",
      "properties": {
        "artifact_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactId"
          }
        },
        "include_redistributable_assets": {
          "type": "boolean"
        },
        "module_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModuleRef"
          }
        },
        "purpose": {
          "$ref": "#/$defs/PackagePurpose"
        },
        "run_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RunId"
          }
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScenarioId"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "purpose",
        "scenarios",
        "run_ids",
        "artifact_ids",
        "module_refs",
        "include_redistributable_assets"
      ]
    },
    "ProjectId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "RunId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "SafeUint": {
      "type": "integer",
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0
    },
    "ScenarioId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "SelectedFileRef": {
      "type": "object",
      "properties": {
        "purpose": {
          "$ref": "#/$defs/FilePurpose"
        },
        "selection_id": {
          "$ref": "#/$defs/ObjectId"
        }
      },
      "additionalProperties": false,
      "required": [
        "selection_id",
        "purpose"
      ]
    },
    "VersionId": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    }
  }
}
