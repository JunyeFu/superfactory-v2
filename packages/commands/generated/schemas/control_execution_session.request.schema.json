{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HostControlRequest",
  "type": "object",
  "properties": {
    "api_version": {
      "$ref": "#/$defs/ApiVersion"
    },
    "operation": {
      "$ref": "#/$defs/HostControlRequestOperation"
    },
    "params": {
      "$ref": "#/$defs/HostControlRequestParams"
    },
    "project_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProjectId"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_id": {
      "$ref": "#/$defs/ObjectId"
    },
    "scope": {
      "$ref": "#/$defs/HostProjectScope"
    }
  },
  "additionalProperties": false,
  "required": [
    "api_version",
    "request_id",
    "project_id",
    "scope",
    "operation",
    "params"
  ],
  "$defs": {
    "ApiVersion": {
      "type": "string",
      "enum": [
        "0.1"
      ]
    },
    "ControlAction": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "run"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "pause_dispatch"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "resume_dispatch"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "stop_dispatch"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "request_reconciliation"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "accept_new_work": {
              "type": "boolean"
            },
            "device_id": {
              "$ref": "#/$defs/ObjectId"
            },
            "kind": {
              "type": "string",
              "const": "set_device_acceptance"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "device_id",
            "accept_new_work"
          ]
        }
      ]
    },
    "ExecutionContractVersion": {
      "type": "string",
      "enum": [
        "sf.execution/2.0-draft11"
      ]
    },
    "ExecutionEpochId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "ExecutionIdentity": {
      "type": "object",
      "properties": {
        "execution_epoch_id": {
          "$ref": "#/$defs/ExecutionEpochId"
        },
        "host_context_session_id": {
          "$ref": "#/$defs/ObjectId"
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "session_id": {
          "$ref": "#/$defs/ExecutionSessionId"
        }
      },
      "additionalProperties": false,
      "required": [
        "session_id",
        "execution_epoch_id",
        "project_id",
        "host_context_session_id"
      ]
    },
    "ExecutionSessionId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "HostControlRequestOperation": {
      "type": "string",
      "enum": [
        "control_execution_session"
      ]
    },
    "HostControlRequestParams": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/ControlAction"
        },
        "execution_contract_version": {
          "$ref": "#/$defs/ExecutionContractVersion"
        },
        "expected_execution_revision": {
          "$ref": "#/$defs/SafeUint"
        },
        "identity": {
          "$ref": "#/$defs/ExecutionIdentity"
        }
      },
      "additionalProperties": false,
      "required": [
        "execution_contract_version",
        "identity",
        "expected_execution_revision",
        "action"
      ]
    },
    "HostProjectScope": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/HostProjectScopeKind"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    "HostProjectScopeKind": {
      "type": "string",
      "enum": [
        "project"
      ]
    },
    "ObjectId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "ProjectId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "SafeUint": {
      "type": "integer",
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0
    }
  }
}
